# Interactive shell config.

# Some terminals start non-login shells, which skip .zprofile.
[[ -o login ]] || source ~/.zprofile

# ---------------------------------------------------------------------------
# Zsh options
# ---------------------------------------------------------------------------

# Remove older command from the history if a duplicate is to be added.
setopt HIST_IGNORE_ALL_DUPS
# Emacs-style line editing (Ctrl-A, Ctrl-E, ...).
bindkey -e
# Prompt for spelling correction of commands.
setopt CORRECT
# Remove path separator from WORDCHARS.
WORDCHARS=${WORDCHARS//[\/]}
unsetopt BEEP

# Extra completions (e.g. generated by a CLI's `--install-completion`).
# Must be on fpath before zim runs compinit.
[[ -d ~/.zfunc ]] && fpath=(~/.zfunc $fpath)

# ---------------------------------------------------------------------------
# Zim
# ---------------------------------------------------------------------------

ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
# Download zimfw plugin manager if missing.
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
      https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
fi
# Install missing modules, and update ${ZIM_HOME}/init.zsh if missing or outdated.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
  source ${ZIM_HOME}/zimfw.zsh init -q
fi
source ${ZIM_HOME}/init.zsh

# zsh-history-substring-search: up/down search history for what's already typed.
zmodload -F zsh/terminfo +p:terminfo
for key ('^[[A' '^P' ${terminfo[kcuu1]}) bindkey ${key} history-substring-search-up
for key ('^[[B' '^N' ${terminfo[kcud1]}) bindkey ${key} history-substring-search-down
for key ('k') bindkey -M vicmd ${key} history-substring-search-up
for key ('j') bindkey -M vicmd ${key} history-substring-search-down
unset key

# ---------------------------------------------------------------------------
# Tools (each only if installed, so a missing tool never breaks the shell)
# ---------------------------------------------------------------------------

has() { (( $+commands[$1] )) }

# mise first: it puts the tools below on PATH (the shims from .zprofile work too, but are slower).
has mise && eval "$(mise activate zsh)"

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd
if has fzf; then
  source <(fzf --zsh)
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

has direnv && eval "$(direnv hook zsh)"
# zoxide takes over cd: real paths, `cd ..` and `cd -` work as usual; otherwise `cd dev` jumps to
# the folder you use most that matches, and `cdi dev` picks from the matches with fzf.
has zoxide && eval "$(zoxide init zsh --cmd cd)"
# Completions come from files in ~/.zfunc (written by chezmoi's setup script), not from eval-ing each
# tool's script here. terraform and aws answer bash-style completion requests instead.
autoload -U +X bashcompinit && bashcompinit
has terraform && complete -o nospace -C terraform terraform
has aws_completer && complete -C aws_completer aws

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------

has nvim && alias vi=nvim
has nvim && alias vim=nvim
has bat && alias cat=bat
has fd && alias find=fd
has rg && alias grep="rg --no-hidden"
has lsd && alias ls="lsd -lhrta --color auto"
has lsd && alias tree="lsd --tree"
has lazygit && alias lzg=lazygit lg=lazygit
has lazydocker && alias lzd=lazydocker
has terraform && alias tf=terraform
has dust && alias du=dust
has duf && alias df=duf

# Left to itself, glow wraps at the window's width but never past 120 columns; -w uses it all.
has glow && alias glow='glow -w ${COLUMNS:-120}'

# ---------------------------------------------------------------------------
# Prompt (last, so it wraps everything above)
# ---------------------------------------------------------------------------

has starship && eval "$(starship init zsh)"
